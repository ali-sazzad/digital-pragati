# Copy to .env.local and fill in. Never commit .env.local.

# The Gmail address the site sends from.
GMAIL_USER=you@gmail.com

# A 16-character app password, not your normal Gmail password.
# Create one at https://myaccount.google.com/apppasswords
# (needs 2-Step Verification turned on for the account).
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Where enquiries are delivered. Optional; defaults to GMAIL_USER.
ENQUIRY_TO=

# Set to "log" to print enquiries instead of sending them (used by the tests).
ENQUIRY_DELIVERY=

# --- Database ---
# Hosted Postgres connection string (Neon, Supabase, ...). Leave empty to use
# PGlite, a built-in Postgres that saves to PGLITE_DIR (fine for development and a
# single self-hosted server; not for serverless hosts like Vercel).
DATABASE_URL=
PGLITE_DIR=.data/pglite

# --- Public enquiry API (/api/enquiry) ---
# Sites allowed to post enquiries from a browser, comma-separated.
ENQUIRY_ALLOWED_ORIGINS=https://www.digitalpragati.com

# --- Admin (/admin) ---
# Sign-in for the enquiries list. With no password set, /admin stays closed.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Enquiries per connection per 10 minutes on /api/enquiry (default 5).
ENQUIRY_RATE_LIMIT=
